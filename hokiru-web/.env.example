# ── HOKIRU Web environment template ──────────────────────────────────
# Copy to .env.local for local dev. All values below are optional for
# running the MVP locally — the app falls back to local/static data
# when Supabase is not configured (see lib/supabase/client.ts).

# Supabase (optional at MVP stage — anon-first usage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel (used by CI/scripts, not required for `npm run dev`)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Claude / nightly AI dev run (GitHub Actions secret, see docs/operations/ai-nightly-run.md)
ANTHROPIC_API_KEY=

# Notion sync (see docs/operations/notion-update-spec.md)
NOTION_API_KEY=
NOTION_STRATEGY_PAGE_ID=

# GitHub (used by scripts/create-decision-issue.ts when run outside Actions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
